PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/voice_nl
NODE_ENV=development

# Public, internet-reachable base URL of THIS API. Used to build the membership QR
# image and verification links embedded in confirmation emails and PDF receipts.
# Local dev defaults to http://localhost:<PORT>. In production set this to the live
# API host so QR images load in email clients, e.g. https://voice-nl-api.onrender.com
PUBLIC_API_URL=http://localhost:5000

# --- Auth (JWT) ---
# Required in production. Use a long random string (e.g. openssl rand -base64 48).
JWT_SECRET=change_me_to_a_long_random_secret

# --- Admin seed (npm run seed:admin) — stored in admins collection on cluster17 ---
# ADMIN_SEED_EMAIL=admin@stichtingthevoice.nl
# ADMIN_SEED_PASSWORD=VoiceAdmin@2025
# ADMIN_SEED_FIRST_NAME=Site
# ADMIN_SEED_LAST_NAME=Administrator

# --- Google Sign-In (same Web client ID as client VITE_GOOGLE_CLIENT_ID) ---
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Cloudflare Turnstile CAPTCHA (public auth, contact, testimonials) ---
# Secret key from Cloudflare Turnstile widget settings.
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Optional: override the verification endpoint.
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Ticket Tailor (dashboard tickets, membership, donations) ---
# API key from Box office settings → API. Used server-side only.
# IMPORTANT: When creating the key, disable "hide personal data" so buyer emails are not masked (****).
TICKET_TAILOR_API_KEY=
# TICKET_TAILOR_API_BASE=https://api.tickettailor.com
# Product IDs for Donate / sponsorship products (comma-separated)
# TICKET_TAILOR_DONATION_PRODUCT_IDS=pr_23684
# TICKET_TAILOR_SPONSORSHIP_PRODUCT_IDS=

# --- Stripe (live account) ---
# Live keys: https://dashboard.stripe.com/apikeys (toggle Live mode, top-right)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
# Live webhook signing secret: Developers → Webhooks → your endpoint → Signing secret
# Endpoint URL: https://<your-api-host>/api/payments/webhook
# Include platform payment events plus connected-account events:
# payment_intent.*, charge.refunded, charge.dispute.*, account.updated,
# capability.*, account.external_account.*, payout.*
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here
# 3-letter ISO currency code used for sponsorship payments
PAYMENT_CURRENCY=eur

# --- Email (Nodemailer SMTP) ---
# SiteGround (recommended if your domain email is hosted there):
#   Site Tools → Email → Accounts → Mail Configuration → Manual settings
#   EMAIL_HOST is usually mail.yourdomain.com, port 465, secure=true
# Also works with Gmail, SendGrid, Mailgun, or any SMTP provider.
EMAIL_HOST=mail.stichtingthevoice.nl
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@stichtingthevoice.nl
EMAIL_PASS=your_mailbox_password
# Friendly From line — use the same mailbox as EMAIL_USER for SiteGround
EMAIL_FROM=Stichting The V.O.I.C.E. NL <info@stichtingthevoice.nl>
# Optional: public contact / receipt footer (donation & sponsorship emails, PDF footers)
CONTACT_EMAIL=info@stichtingthevoice.nl
# Optional: where internal notifications are sent
ORG_NOTIFY_EMAIL=info@stichtingthevoice.nl

# --- Apple Wallet (membership e-card .pkpass download) ---
# Create a Pass Type ID and signing certificates in Apple Developer → Certificates, Identifiers & Profiles.
# APPLE_WALLET_PASS_TYPE_ID=pass.nl.stichtingthevoice.membership
# APPLE_WALLET_TEAM_ID=YOUR_TEAM_ID
# APPLE_WALLET_WWDR_CERT_PATH=./certs/AppleWWDRCAG4.pem
# APPLE_WALLET_SIGNER_CERT_PATH=./certs/pass.pem
# APPLE_WALLET_SIGNER_KEY_PATH=./certs/pass.key
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=

# --- Google Wallet (membership e-card save link) ---
# Enable the Google Wallet API and create a service account with Wallet Object Issuer role.
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_CLASS_SUFFIX=voice_membership
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet@your-project.iam.gserviceaccount.com
# GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- V.Assist (Personal AI Assistant chat) ---
# Required for the AI assistant feature; everything else still works if blank.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Web Push (V.Assist scheduled-prompt notifications) ---
# Optional — that one feature no-ops if left blank. Generate a pair with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@stichtingthevoice.nl

# --- Sponsorship receipt + email branding ---
# Optional: extra line below donation thank-you email (plain text; shown centered under the card).
EMAIL_FOOTER_OPTIONAL=

# One-line tagline shown under the wordmark on the PDF receipt.
ORG_TAGLINE=The voice of international cultural exchange in the Netherlands
# pCloud (or other) link sponsors use to upload their assets after payment.
SPONSOR_UPLOAD_URL=https://e.pcloud.com/#/puplink?code=a0d7Z7oHyALJyo1QSVj7EPvLx5y5ySo37
